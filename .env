# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://dbUser:myPassword@cluster0.bw92e.mongodb.net/

# Database name inside MongoDB
MONGODB_DB_NAME=project_loop

# Flask session secret - generate a long random value for production
SECRET_KEY=replace-with-a-long-random-secret

# Demo/admin account created automatically on first startup
ADMIN_EMAIL=admin@loop.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=LOOP Admin

# Optional local debug
FLASK_DEBUG=false
